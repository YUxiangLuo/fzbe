{
  "name": "fangzhen",
  "module": "index.ts",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx tsc --noEmit --pretty false",
    "lint:openapi": "bunx @redocly/cli@2.39.0 lint docs/openapi.yaml",
    "test": "bun run test:unit",
    "test:check": "bun run typecheck && bun run lint:openapi && bun run test:list && bun run test:unit",
    "test:list": "bun run tests/inventory.ts",
    "test:unit": "bun test tests/unit --isolate",
    "test:unit:config": "bun test tests/unit/config --isolate",
    "test:unit:controllers": "bun test tests/unit/controllers --isolate",
    "test:unit:models": "bun test tests/unit/models --isolate",
    "test:unit:policies": "bun test tests/unit/policies --isolate",
    "test:unit:routing": "bun test tests/unit/routing --isolate",
    "test:unit:schemas": "bun test tests/unit/schemas --isolate",
    "test:unit:security": "bun test tests/unit/security --isolate",
    "test:unit:services": "bun test tests/unit/services --isolate",
    "test:unit:utils": "bun test tests/unit/utils --isolate",
    "test:workflow": "py/venv/bin/python py/test/run.py --profile ci",
    "test:workflow:quick": "py/venv/bin/python py/test/run.py --profile quick",
    "test:workflow:full": "py/venv/bin/python py/test/run.py --profile full",
    "test:workflow:contract": "py/venv/bin/python py/test/run.py --suite contract",
    "test:workflow:smoke": "py/venv/bin/python py/test/run.py --suite smoke",
    "test:workflow:parity": "py/venv/bin/python py/test/run.py --suite parity",
    "test:workflow:regression": "py/venv/bin/python py/test/run.py --suite regression",
    "test:workflow:diagnostic": "py/venv/bin/python py/test/run.py --suite diagnostic",
    "test:workflow:stress": "py/venv/bin/python py/test/run.py --suite stress",
    "test:deep:fast": "py/venv/bin/python py/deep_tests/run.py --profile fast",
    "test:deep:full": "py/venv/bin/python py/deep_tests/run.py --profile full",
    "test:deep:nightly": "py/venv/bin/python py/deep_tests/run.py --profile nightly",
    "test:deep:resource": "py/venv/bin/python py/deep_tests/run.py --profile resource",
    "test:system:model-edge": "bun run tests/system/model-edge-cases.ts --layer=all --profile=full",
    "test:system:model-edge:python": "bun run tests/system/model-edge-cases.ts --layer=python --profile=full",
    "test:system:model-edge:api": "bun run tests/system/model-edge-cases.ts --layer=api --profile=full",
    "test:system:user-phone-canonical": "bun run tests/system/user-phone-canonical-migration.ts",
    "test:full": "bun run test:check && bun run test:workflow:full && bun run test:deep:full",
    "test:python:deep": "bun run test:deep:fast",
    "test:python:fast": "bun run test:deep:fast",
    "test:python:full": "bun run test:deep:full",
    "test:python:nightly": "bun run test:deep:nightly",
    "test:python:resource": "bun run test:deep:resource",
    "test:algorithms": "bun test tests/unit/models/model-context.algorithm-contract.test.ts --isolate && bun run test:deep:full",
    "model:edge": "bun run test:system:model-edge",
    "model:edge:python": "bun run test:system:model-edge:python",
    "model:edge:api": "bun run test:system:model-edge:api",
    "db:reset": "bun run scripts/db-reset.ts",
    "db:reset:live": "bun run scripts/db-reset-live.ts",
    "db:reset:parallel": "bun run scripts/db-reset-parallel.ts",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:migrate:academic-terms": "bun run scripts/migrate-academic-terms.ts",
    "db:migrate:user-phone-unique": "bun run scripts/migrate-user-phone-unique.ts",
    "db:migrate:user-phone-canonical-unique": "bun run scripts/migrate-user-phone-canonical-unique.ts",
    "db:migrate:quiz-answer-snapshots": "bun run scripts/migrate-quiz-answer-snapshots.ts",
    "db:migrate:question-answer-explanations": "bun run scripts/migrate-question-answer-explanations.ts",
    "db:migrate:model-training": "bun run scripts/migrate-model-training.ts",
    "db:migrate:guided-training": "bun run scripts/migrate-guided-training-sessions.ts",
    "db:migrate:production-preparation": "bun run scripts/migrate-production-preparation-sessions.ts",
    "db:migrate:model-training-integrity": "bun run scripts/migrate-model-training-integrity.ts",
    "db:migrate:production-forecast-evidence": "bun run scripts/migrate-production-forecast-evidence.ts",
    "db:migrate:experiment-retry-lineage": "bun run scripts/migrate-experiment-retry-lineage.ts",
    "db:migrate:experiment-report-status-index": "bun run scripts/migrate-experiment-report-status-index.ts",
    "db:migrate:experiment-retry-delete-rule": "bun run scripts/migrate-experiment-retry-delete-rule.ts",
    "db:migrate:production-inventory-precision": "bun run scripts/migrate-production-inventory-precision.ts",
    "db:migrate:rejected-report-grades": "bun run scripts/migrate-rejected-report-grades.ts",
    "seed:teacher1:presentation": "bun run scripts/seed-teacher1-presentation.ts",
    "seed:parallel:assets": "bun run scripts/seed-parallel-assets.ts",
    "seed:parallel:scenario": "bun run scripts/seed-parallel-scenarios.ts",
    "seed:parallel:report-burst": "bun run scripts/seed-parallel-report-burst.ts",
    "dogfood:student:seed": "bun run scripts/seed-student-dogfood.ts",
    "dogfood:student:verify": "bun run scripts/verify-student-dogfood.ts",
    "hash-password": "bun run scripts/hash-password.ts"
  },
  "type": "module",
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "csv-parser": "^3.2.0",
    "hono": "^4.13.1",
    "marked": "^17.0.0",
    "mysql2": "^3.15.3",
    "pino": "^10.1.0",
    "puppeteer-core": "^25.3.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.5"
  }
}
