# Backend runtime
# Copy this file to .env and replace placeholder secrets before starting the service.
# Production mode activates strict secret, E2E-route, and single-listener checks.
NODE_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fangzhen
DB_PASSWORD=change_me
DB_DATABASE=fangzhen
# Fail fast when the database is unreachable and keep request queues bounded.
DB_CONNECT_TIMEOUT_MS=10000
DB_QUEUE_LIMIT=100
# The backend aligns every database session with this parser timezone. UTC is
# the safe default; fixed offsets such as +08:00 are supported when required.
DB_TIMEZONE=Z
DB_DATE_STRINGS=false
# Use required/verify_ca/verify_identity when connecting to a remote managed MySQL/MariaDB.
DB_SSL_MODE=disabled
# DB_SSL_CA_PATH=/etc/ssl/certs/mysql-ca.pem
DB_SSL_REJECT_UNAUTHORIZED=true

# Production rejects this placeholder. Replace it with 32+ random non-whitespace characters.
JWT_SECRET=change_me

# Production-forecast evidence uses a domain-separated key derived from
# JWT_SECRET, so no additional evidence-key configuration is required. Rotating
# JWT_SECRET invalidates pending plan evidence; affected users must predict
# again. Completed experiment history is not revalidated and remains available.

# Temporary frontend-compatibility switch. Keep this false normally. Set it
# only while already-open old frontend pages may call the newly restarted single
# backend, then turn it off as soon as every frontend is v2.
ALLOW_LEGACY_PRODUCTION_PLAN_WRITES=false
# Production single-instance binding is fixed to 127.0.0.1:3001; nginx proxies
# only to this listener and a second backend fails before startup reconciliation.
PORT=3001
# Required in production. Comma-separated browser origins allowed to call the API and direct file routes.
# Example: CORS_ALLOWED_ORIGINS=https://example.edu,https://www.example.edu
CORS_ALLOWED_ORIGINS=http://localhost:4000
# Keep the Bun backend private behind nginx. Use 0.0.0.0 only for trusted dev environments.
HOST=127.0.0.1

# Chrome/Chromium used by Puppeteer for report/PDF generation.
# The deployment guide installs google-chrome-stable; use /usr/bin/chromium if that is what your host provides.
CHROMIUM_PATH=/usr/bin/google-chrome-stable
LOG_LEVEL=info

# Bun HTTP idle timeout. Bun accepts 1-255 seconds.
# Long-running model endpoints disable idle timeout per request, but this prevents ordinary slow responses from timing out too early.
BUN_IDLE_TIMEOUT_SECONDS=255

# Model execution timeouts. Training and prediction may be shortened, but the
# backend enforces an absolute, non-configurable 600000ms (10 minute) ceiling.
# Ensemble budgets are calculated dynamically and clamped to that ceiling.
# MODEL_TRAINING_TIMEOUT_MS=300000
# MODEL_PREDICTION_TIMEOUT_MS=60000
# Each guided step, prepare-production request, prediction request, or ADF call
# gets its own independent backend deadline. It is not an experiment-wide limit.
# Static backend/nginx/browser ceilings come from contracts/model-http-timeouts.json.
# This value may shorten the effective backend deadline but cannot exceed that
# contract. Startup also validates termination grace and response reserve
# against the generated model and ADF nginx budgets.
# MODEL_OPERATION_DEADLINE_MS=660000
# MODEL_PROCESS_TERMINATION_GRACE_MS=5000

# SINGLE-INSTANCE ONLY: run exactly one Bun backend process. Model admission,
# per-experiment/model exclusion, PDF queueing, auth limits, and cleanup
# coordination are process-local. Do not use rolling/surge overlap or workers.
# Concurrency is automatic; leave these unset unless intentionally overriding:
# - MAX_CONCURRENT_MODEL_JOBS = min(availableParallelism(), 50)
# - MAX_CONCURRENT_PDF_JOBS = min(ceil(availableParallelism() / 4), 12)
# - DB_CONNECTION_LIMIT = max(40, ceil(MAX_CONCURRENT_MODEL_JOBS/2))
# - PYTHON_MODEL_THREADS = 1, TF_NUM_INTEROP_THREADS = 1
# DB_CONNECTION_LIMIT cannot be below its computed single-instance minimum.
# MariaDB/MySQL max_connections must be >= DB_CONNECTION_LIMIT.
# MAX_CONCURRENT_MODEL_JOBS=50
# MAX_CONCURRENT_PDF_JOBS=12
# PDF_QUEUE_TIMEOUT_MS=60000
# PDF_GENERATION_TIMEOUT_MS=30000
# DB_CONNECTION_LIMIT=40
# PYTHON_MODEL_THREADS=1
# TF_NUM_INTEROP_THREADS=1

# Pin this to the deployed application/model-runtime release identifier. Guided
# sessions and production artifacts are invalidated when this value changes;
# when unset, the Bun backend hashes the Python model sources and requirements.
# MODEL_RUNTIME_REVISION=sha256:replace_with_release_digest

# Public authentication endpoints are process-local rate limited, which is
# globally authoritative under the required single-instance deployment.
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX_PER_IP=100
AUTH_LOGIN_RATE_LIMIT_MAX_PER_ACCOUNT=10
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
AUTH_REGISTER_RATE_LIMIT_MAX_PER_IP=50
AUTH_REGISTER_RATE_LIMIT_MAX_PER_ACCOUNT=3

# Runtime disk cleanup runs at startup and then daily. This disables the timer
# for all runtime cleanup steps (guided sessions, exports, temp uploads, models).
# DISABLE_RUNTIME_DISK_CLEANUP_TIMER=1
# Legacy compatibility: only skips interval-triggered guided training cleanup;
# it no longer disables export/temp/model artifact cleanup.
# DISABLE_GUIDED_TRAINING_CLEANUP_TIMER=1

# Example for a 64-core / 100-student classroom server with 50 active model jobs:
# MAX_CONCURRENT_MODEL_JOBS=50
# MAX_CONCURRENT_PDF_JOBS=12
# PDF_QUEUE_TIMEOUT_MS=60000
# PDF_GENERATION_TIMEOUT_MS=30000
# DB_CONNECTION_LIMIT=40
# PYTHON_MODEL_THREADS=1
# TF_NUM_INTEROP_THREADS=1
